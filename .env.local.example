# The map needs no key: MapLibre renders Esri's free ArcGIS Online tiles.

# Key used by scripts/build-data.ts for the Google Geocoding API (rooftop pins).
# Must have "Geocoding API" enabled. Used server-side only, so it can be the same
# key or a separate, IP-restricted one. If unset, the script falls back to the
# free US Census geocoder (street-level).
GOOGLE_GEOCODING_API_KEY=AIza...

# Registration gate lead sinks (server-side, optional; the gate never blocks a
# visitor when these are unset).
# AIRTABLE_PAT=
# AIRTABLE_BASE_ID=
# AIRTABLE_LEADS_TABLE=TX RevPAR Leads
# HUBSPOT_TOKEN=

# Email code step on signup (/api/verify). Off unless BOTH are set.
# RESEND_API_KEY=re_...
# LEAD_VERIFY_FROM=Texas Hotel Data AI <verify@texashoteldata.ai>
# Optional HMAC key for code tokens (derived from RESEND_API_KEY when unset).
# LEAD_VERIFY_SECRET=
